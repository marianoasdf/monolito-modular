generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BarbershopAppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Tenant {
  id                   String                    @id @default(cuid())
  slug                 String                    @unique
  name                 String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  customers            BarbershopCustomer[]
  appointments         BarbershopAppointment[]
  settings             BarbershopTenantSettings?
  auth                 TenantAuth?
  integrations         TenantIntegration[]
  rotisserieCategories RotisserieCategory[]
  rotisserieProducts   RotisserieProduct[]
  rotisserieOrders     RotisserieOrder[]
  rotisserieSettings   RotisserieTenantSettings?

  @@map("tenants")
}

model BarbershopTenantSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  publicName     String?
  description    String?
  mapsUrl        String?
  phone          String?
  weeklySchedule Json?
  expressSlots   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("barbershop_tenant_settings")
}

model BarbershopCustomer {
  id           String                  @id @default(cuid())
  tenantId     String
  fullName     String
  phoneNumber  String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments BarbershopAppointment[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, phoneNumber])
  @@map("barbershop_customers")
}

model BarbershopAppointment {
  id                String                      @id @default(cuid())
  tenantId          String
  customerId        String
  barberId          String
  serviceCode       String
  startsAt          DateTime
  durationInMinutes Int
  status            BarbershopAppointmentStatus @default(SCHEDULED)
  notes             String?
  paymentMethod     String                      @default("cash")
  paymentStatus     String                      @default("not_required")
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          BarbershopCustomer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, barberId, startsAt])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, startsAt])
  @@map("barbershop_appointments")
}

model TenantAuth {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  adminPasswordHash   String?
  supportPasswordHash String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_auth")
}

model TenantIntegration {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_integrations")
}

model RotisserieTenantSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  deliveryFeeInCents Int      @default(250000)
  weeklyMenu         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("rotisserie_tenant_settings")
}

model RotisserieCategory {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  sortOrder      Int                 @default(0)
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       RotisserieProduct[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@map("rotisserie_categories")
}

model RotisserieProduct {
  id             String             @id @default(cuid())
  tenantId       String
  categoryId     String
  name           String
  normalizedName String
  description    String?
  priceInCents   Int
  stockQuantity  Int?
  isAvailable    Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       RotisserieCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("rotisserie_products")
}

model RotisserieOrder {
  id                 String                @id @default(cuid())
  tenantId           String
  customerName       String
  customerPhone      String
  fulfillmentType    String
  deliveryAddress    String?
  paymentMethod      String
  status             String                @default("pending")
  deliveryFeeInCents Int                   @default(0)
  totalInCents       Int
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items              RotisserieOrderItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("rotisserie_orders")
}

model RotisserieOrderItem {
  id               String          @id @default(cuid())
  orderId          String
  tenantId         String
  productId        String
  productName      String
  unitPriceInCents Int
  quantity         Int
  lineTotalInCents Int
  createdAt        DateTime        @default(now())
  order            RotisserieOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("rotisserie_order_items")
}
